# =============================================================================
# SecurePAM .gitignore
# =============================================================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example
.env.local
.env.production
infrastructure/openbao/runtime/
*.pem
*.key
*.crt
*.p12

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Frontend Build ---
frontend/dist/
frontend/build/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Docker ---
docker-compose.override.yml

# --- Data ---
data/
recordings/
logs/
*.log
/keycloak-db.dump
/keycloak-db-fixed.dump
/keycloak-export/

# --- Database ---
*.sql.bak
*.dump

# --- Alembic ---
migrations/versions/__pycache__/

# --- Testing ---
coverage/
.nyc_output/
test-results/

# Local Guacamole database credentials
infrastructure/guacamole/.db_password
infrastructure/guacamole/.owner_password
infrastructure/guacamole/.admin_password
infrastructure/guacamole/recordings/
infrastructure/guacamole/.env
infrastructure/browser-isolation/.isolation_token
# Isolated-browser private-CA trust policy (environment-specific; generated by trust_policy.py)
infrastructure/browser-isolation/trust/*.json

# Terraform working files and local variable values
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
terraform.tfvars

# Local credentials and token material
*-token
root-token
recovery-keys*
id_rsa*
id_ed25519*
*.secret


# Secret-bearing Keycloak realm exports and local handoff packages
*-realm.json
SecurePAM_keycloak_Package.*

# Netlify portfolio demo build output
frontend/dist-demo/
